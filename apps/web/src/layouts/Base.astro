---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { site, withBase } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** Path of the OG image inside public/. */
  image?: string;
  noindex?: boolean;
}

const { title = site.title, description = site.description, image = "og.png", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(image), Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="white" />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={withBase("favicon.ico")} sizes="48x48" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pare — Make room on your PC. Keep what matters." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Pare — Make room on your PC. Keep what matters." />
  </head>
  <body class="bg-bg-surface font-sans text-text-primary">
    <a
      href="#main"
      class="focus-ring sr-only z-50 rounded-md bg-accent-default px-4 py-2 text-label-m text-text-on-accent focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
