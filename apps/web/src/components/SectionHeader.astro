---
interface Props {
  id: string;
  overline: string;
  title: string;
  sub?: string;
}
const { id, overline, title, sub } = Astro.props;
---

<div class="mx-auto flex max-w-[1000px] flex-col items-center gap-4 text-center">
  <p class="m-0 text-overline uppercase text-accent-default">{overline}</p>
  <h2 id={id} class="m-0 text-balance text-heading-h1 text-text-primary md:text-display-l">{title}</h2>
  {sub ? <p class="m-0 max-w-[640px] text-pretty text-body-l text-text-secondary">{sub}</p> : null}
</div>
